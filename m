+/* Tells if a rectangle has changed */
+int is_changed_rect(
+		    igd_rect_t *old_rect,
+		    igd_rect_t *new_rect)
+{
+	return ((old_rect->x1 != new_rect->x1) ||
+		(old_rect->x2 != new_rect->x2) ||
+		(old_rect->y1 != new_rect->y1) ||
+		(old_rect->y2 != new_rect->y2) );
+}

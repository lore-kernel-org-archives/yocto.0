+
+/* set mmio register required values */
+static fixed_clock_t sdvo_fixed_clock_table[] =  {
+	/* Clock       N     M    P1 */
+	{ 65000,      0x00, 0x00, 0x00 },
+	{ 0xffffffff, 0x00, 0x00, 0x00}

++static int XGIfb_heap_init(void)
++{
++	XGI_OH *poh;
++	u8 temp=0;
++
++	int            agp_enabled = 1;
++	u32            agp_size;
++	unsigned long *cmdq_baseport = 0;
++	unsigned long *read_port = 0;
++	unsigned long *write_port = 0;

+
+	/* Build our Huffman distance tree using the fixed codes */
+	new_node = (huffman_node *)kzalloc(sizeof(huffman_node), GFP_KERNEL);
+	if (!new_node) {
+		EMGD_ERROR("Out of memory.");
+		return;

+
+	if (!drm_data->rtn) {
+		/* Get the number of display dimensions: */
+		EMGD_DEBUG("Calling PVRSRVEnumDCDimsKM()");
+		err = PVRSRVEnumDCDimsKM(dev_handle[which_device], pf, &num_dims, NULL);

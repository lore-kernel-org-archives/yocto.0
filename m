++++ b/vendor/rustix-0.38.6/src/backend/libc/fs/syscalls.rs
+@@ -2445,7 +2445,7 @@ pub(crate) fn ioctl_blkpbszget(fd: Borro
+ }
+=20
+ // Sparc lacks `FICLONE`.

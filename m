> TOOLCHAIN_TARGET_TASK +=3D "${PACKAGE_INSTALL}"
> export PACKAGE_INSTALL ?=3D "${IMAGE_INSTALL} ${ROOTFS_BOOTSTRAP_INSTALL}
> ${FEATURE_INSTALL}"
>

+++		writel(status, chip->base + MV_AUDIO_INT_CAUSE_REG);
+++
+++		/* This is record event */
+++		if (status & AICR_RECORD_BYTES_INT)
+++			snd_pcm_period_elapsed(capture_stream->substream);
+++
+++		/* This is play event */
+++		if (status & AICR_PLAY_BYTES_INT)

+		psOEMJTable->pfnOEMWriteRegistryString = IMG_NULL;
+#else
+		psOEMJTable->pfnOEMReadRegistryString  = IMG_NULL;
+		psOEMJTable->pfnOEMWriteRegistryString = IMG_NULL;
+#endif
+		return PVRSRV_OK;
+	}
+
+	return PVRSRV_ERROR_INVALID_PARAMS;
+}

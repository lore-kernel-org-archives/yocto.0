diff --git a/plugins/org.yocto.sdk.doc.user/html/dev-manual/platdev-gdb-remotedebug-launch-gdbserver.html b/plugins/org.yocto.sdk.doc.user/html/dev-manual/platdev-gdb-remotedebug-launch-gdbserver.html

+					(pOutput_Info->h_flip == 0)  )   ) 	? 1 : 0;
+	iic_write_ex(CHG_HL, chg_hl_reg);
+
+	
+	vsmst_reg = 2;
+	iic_write_ex(VSMST, vsmst_reg);
+
+	return ch_true;	

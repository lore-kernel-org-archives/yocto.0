+++            {
+++                 VCLKIndex = LCDXlat1VCLK[ CRT2Index ] ;
+++            }
+++        }
+++        else	/* for TV */
+++        {
+++            if ( pVBInfo->VBInfo & SetCRT2ToTV )
+++            {
+++                if ( pVBInfo->VBInfo & SetCRT2ToHiVisionTV )
+++                {
+++                    if ( pVBInfo->SetFlag & RPLLDIV2XO )

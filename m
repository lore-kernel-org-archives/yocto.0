++    temp =0;
++    if ( ( CR38 & 0xE0 ) > 0x80 )
++    {
++        temp = XGINew_GetReg1( pVBInfo->P3d4 , 0x48 ) ;
++        temp &= 0x08;
++        temp >>= 3;
++    }
++    
++    XGINew_SetReg1( pVBInfo->P3d4, 0x4A , CR4A ) ;
++    
++    return temp;
++}

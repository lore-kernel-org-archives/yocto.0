+	{PD_ATTR_ID_FP_PWR_T2,       2,     0 }, /* 7 */
+	{PD_ATTR_ID_FP_PWR_T3,       2,     0 }, /* 8 */
+	{PD_ATTR_ID_FP_PWR_T4,       2,     0 }, /* 9 */
+	{PD_ATTR_ID_FP_PWR_T5,       2,     0 }  /* 10 */
+};

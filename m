+/*===========================================================================
+; File Global Data
+;--------------------------------------------------------------------------*/
+#if CONFIG_FIXED_TABLE
+typedef struct _fixed_clock {
+	unsigned long dclk;
+	unsigned long n;
+	unsigned long m;
+	unsigned long p1;
+} fixed_clock_t;
+
+/* set mmio register required values */
+static fixed_clock_t lvds_fixed_clock_table[] =  {
+	/* Clock       N     M     P1 */
+	{ 65000,      0x01, 0x00, 0x00 },
+	{ 0xffffffff, 0x01, 0x00, 0x00}

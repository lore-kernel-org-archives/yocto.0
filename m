-    # Create package-file
-    cat > ${PACKAGE_FILE} << EOF
-# NAME		Relative path
-package-file	${PACKAGE_FILE}
-bootloader	${LOADER}
-parameter	${PARAMETER}
-boot		${BOOT_IMG}
-linuxroot	${IMAGE_NAME}.rootfs.ext4
-EOF
-
-    # Create parameter
-    cat > ${PARAMETER} << EOF
-FIRMWARE_VER:${FIRMWARE_VER}
-MACHINE_MODEL:${MACHINE}
-MACHINE_ID:007
-MANUFACTURER:${MANUFACTURER}
-MAGIC: 0x5041524B
-ATAG: 0x60000800
-MACHINE: 3066
-CHECK_MASK: 0x80
-KERNEL_IMG: 0x60408000
-#RECOVER_KEY: 1,1,0,20,0
-CMDLINE:${CMDLINE} initrd=3D0x62000000,0x00800000 mtdparts=3Drk29xxnand:${=
MTDPARTS}
-EOF
-
-    # Create boot.img
-    mkbootimg --kernel ${KERNEL_IMG} --ramdisk ${INITRD_IMG} -o ${BOOT_IMG}
-
-    # Build update.img using afptool and img_maker

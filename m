+	if(!off)
+	{
+		return PVR_PROC_SEQ_START_TOKEN;
+	}
+
+    SysAcquireData(&psSysData);
+
+
+	psDevNode = (PVRSRV_DEVICE_NODE*)
+				List_PVRSRV_DEVICE_NODE_Any_va(psSysData->psDeviceNodeList,

+			       igd_rect_t     *src_rect,
+			       igd_rect_t     *dest_rect,
+			       igd_ovl_info_t *ovl_info,
+			       unsigned int    flags,
+			       povl_plb_cache_t ovl_cache);
+
+
+
+#endif /* _OVL_PLB_CACHE_H */

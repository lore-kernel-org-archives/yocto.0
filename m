+	if (!drm_data->rtn) {
+		/* Get the the number of pixel formats: */
+		EMGD_DEBUG("Calling PVRSRVEnumDCFormatsKM()");
+		err = PVRSRVEnumDCFormatsKM(dev_handle[which_device], &num, NULL);
+		if (err != PVRSRV_OK) {
+			TEST_ERROR("[EMGD] PVRSRVEnumDCFormatsKM() returned %d\n",err);

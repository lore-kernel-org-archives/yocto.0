+/*!
+ *
+ * @param mmio
+ * @param n
+ *
+ * @return void
+ */
+void set_3f_palette(unsigned char *mmio, int n)
+{
+	int i;
+	for(i=0; i<n*3; i++) {
+		EMGD_WRITE8(0x3f, EMGD_MMIO(mmio) + 0x3c9);
+	}
+}

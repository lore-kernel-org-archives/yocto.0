+ *----------------------------------------------------------------------------
+ */
+int lvds_get_attrs (void *context, unsigned long *num, pd_attr_t **list)
+{                                                         /* lvds_get_attrs */
+	/* basic parameter check */
+	if (!context || !num || !list) {
+		return PD_ERR_NULL_PTR;
+	}
+
+	PD_DEBUG("lvds_get_attrs()\n");

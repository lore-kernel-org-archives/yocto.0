++UCHAR GetXG27FPBits(PVB_DEVICE_INFO pVBInfo)
++{
++    UCHAR CR38,CR4A,temp;
++    
++    CR4A = XGINew_GetReg1( pVBInfo->P3d4 , 0x4A ) ;

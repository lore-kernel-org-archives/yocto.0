+static int igd_query_in_vblank_plb(igd_display_h display_handle)
+{
+	int sl;
+
+	igd_get_scanline_plb(display_handle, &sl);
+	if (sl == IGD_IN_VBLANK) {
+		return 1; /*TRUE*/
+	} else {
+		return 0; /*FALSE*/
+	}
+}

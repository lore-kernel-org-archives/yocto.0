+int ch7036_get_attributes(void *p_context, unsigned long *p_num_attr,
+	pd_attr_t **pp_list)
+{
+	ch7036_device_context_t *p_ctx = (ch7036_device_context_t *)p_context;
+		
+	
+
+	PD_DEBUG("ch7036: ch7036_get_attributes()-enter\n");
+

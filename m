+++                    if ( pVBInfo->VBType & VB_XGI301LV )	/* 301lv */
+++                    {
+++                        if ( !( pVBInfo->VBExtInfo == VB_YPbPr1080i ) )
+++                        {
+++                            VCLKIndex = YPbPr750pVCLK ;
+++                            if ( !( pVBInfo->VBExtInfo == VB_YPbPr750p ) )
+++                            {
+++                                VCLKIndex = YPbPr525pVCLK ;
+++                                if ( !( pVBInfo->VBExtInfo == VB_YPbPr525p ) )

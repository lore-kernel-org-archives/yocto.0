+								drm_data->kernel_virt_addr,
+								&(drm_data->fence_id));
+			break;
+		default:
+			break;
+	}
+
+
+	EMGD_DEBUG("drm_data->rtn = %d", drm_data->rtn);
+	EMGD_TRACE_EXIT;

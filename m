+/*!
+ * Convert a DC value into to bitmasks, one for each pipe.
+ *
+ * @param dc
+ * @param pipe1
+ * @param pipe2
+ *
+ * @return void
+ */
+static void dsp_dc_to_masks(unsigned long dc,
+		unsigned char *pipe1,
+		unsigned char *pipe2)
+{
+	int i;
+	int pn;
+
+	*pipe1 = 0;
+	*pipe2 = 0;
+
+	for (i = 1; i < 8; i++) {
+		if ((pn = DC_PORT_NUMBER(dc, i)) > 0) {
+			if ((i < 5)) {
+				*pipe1 |= (1 << pn);
+			} else {
+				*pipe2 |= (1 << pn);
+			}
+		}
+	}
+}

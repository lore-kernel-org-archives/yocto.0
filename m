++	       (base + MV_AUDIO_PLAYBACK_CTRL_REG));
++
++	writel(readl(base + MV_AUDIO_RECORD_CTRL_REG) &
++	       (~(ARCR_RECORD_SPDIF_EN_MASK | ARCR_RECORD_I2S_EN_MASK)),
++	       (base + MV_AUDIO_RECORD_CTRL_REG));

++    if ( temp <= 2 )
++    {
++    	temp &= 0x03;
++    }
++    else
++    {
++    	temp = ((temp&0x04)>>1) || ((~temp)&0x01);
++    }
++    XGINew_SetReg1( pVBInfo->P3d4, 0x4A , CR4A ) ;
++    
++    return temp;
++}

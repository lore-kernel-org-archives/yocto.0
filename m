++	R_JUSTIFIED_UP_TO_24_BIT,
++	R_JUSTIFIED_20_BIT,
++	R_JUSTIFIED_18_BIT,
++	R_JUSTIFIED_16_BIT
++
++};
++
++/* Selects either the I2S or Left-Justified digital interface format for the
++   data on SDOUT. */
++enum adc_mode {
++	LEFT_JUSTIFIED_MODE,
++	I2S_MODE
++};

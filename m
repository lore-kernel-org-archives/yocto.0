+/* Copies a source rectangle to the cache */
+void copy_src_rect_tnc(igd_rect_t *src_rect, povl_tnc_cache_t ovl_cache)
+{
+	if (src_rect) {
+		OS_MEMCPY(&ovl_cache->src_rect,
+			  src_rect,
+			  sizeof(igd_rect_t));
+	} else {
+		OS_MEMSET(&ovl_cache->src_rect,
+			  0,
+			  sizeof(igd_rect_t));
+	}
+}

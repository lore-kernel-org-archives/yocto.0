+			(count * sizeof(igd_display_info_t)));
+		EMGD_DEBUG("Copied list");
+	}
+
+	/* Finally, if a non-live list was requested, free the kernel memory: */
+	if (!(drm_data->flags & IGD_QUERY_LIVE_MODES)) {
+		dispatch->free_mode_list(mode_list);
+	}

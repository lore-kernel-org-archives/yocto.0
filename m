+++    double d;
+++#ifdef SWAP
+++    struct {
+++      unsigned long lower;
+++      long upper;
+++    } l;
+++#else
+++    struct {
+++      long upper;
+++      unsigned long lower;
+++    } l;
+++#endif
+++    long long ll;
+++};

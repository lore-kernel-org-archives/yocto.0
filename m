+                       in_list->refresh = 72;
+                       in_list->htotal = 831;
+                       in_list->vtotal = 519;
+                       in_list->hblank_start = 646;
+                       in_list->vblank_start = 486;
+                       return 1;
+       }
+
+
+       return 0;

+/*!
+ *
+ * @param display_handle
+ *
+ * @return 1 if TRUE
+ * @return 0 if FALSE
+ */
+static int igd_query_in_vblank_tnc(igd_display_h display_handle)
+{
+	int sl;
+
+	/* To small for Tracing */
+
+	igd_get_scanline_tnc(display_handle, &sl);
+	if (sl == IGD_IN_VBLANK) {
+		return 1; /*TRUE*/
+	} else {
+		return 0; /*FALSE*/
+	}
+}

+static IMG_VOID SetDCState(IMG_HANDLE device_h, IMG_UINT32 state)
+{
+	emgddc_devinfo_t *devinfo = (emgddc_devinfo_t *) device_h;
+
+	EMGD_TRACE_ENTER;
+	EMGD_DEBUG("device_h = 0x%p", device_h);
+
+
+	if (!is_valid_devinfo((emgddc_devinfo_t *) device_h)) {

+	unsigned char  cols;
+	unsigned char  rows;                 /* #rows-1 */
+	unsigned char  char_height;
+	unsigned short video_buff_size;
+	unsigned char  sr_regs[4];
+	unsigned char  misc_reg;
+	unsigned char  crtc_regs[25];
+	unsigned char  ar_regs[20];
+	unsigned char  gr_regs[9];
+} vga_mode_data_t;

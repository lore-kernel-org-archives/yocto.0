++			if ((auddec_volume_mapping[i] >
++			      auddec_volume_mapping[AUD_NUM_VOLUME_STEPS-1])
++			    && (reg_data[vol_idx] > auddec_volume_mapping[i])
++			    && (reg_data[vol_idx] < auddec_volume_mapping[i+1]))
++				break;
++		}

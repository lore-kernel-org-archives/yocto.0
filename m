+++int XGIfb_initaccel(void)
+++{
+++#ifdef XGIFB_USE_SPINLOCKS
+++    spin_lock_init(&xgi_video_info.lockaccel);
+++#endif
+++    return(0);
+++}
+++
+++void XGIfb_syncaccel(void)
+++{
+++    
+++    XGI310Sync();
+++    
+++}

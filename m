++	if (substream->dma_buffer.area != NULL &&
++	    substream->dma_buffer.bytes >= size) {
++		buf = &substream->dma_buffer;
++	} else {
++		buf = kmalloc(sizeof(struct snd_dma_buffer), GFP_KERNEL);
++		if (!buf) {
++			snd_printk("buf == NULL\n");

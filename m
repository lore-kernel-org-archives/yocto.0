+	            continue;
+	        }
+			status = sdvo_execute_command(p_ctx, g_bool_data[i].opcode_get,
+						 0, NULL,
+						 1, &ret_value);
+			if (status != SS_SUCCESS) {
+
+				continue;
+			}
+
+			num_attrs++;
+		}
+
+		return num_attrs;
+	}
+
+	/*	..................................................................... */
+	num_attrs = 0;
+
+	for (i = 0; i < ARRAY_SIZE(g_bool_data); i++) {

+++                                    if ( !( pVBInfo->SetFlag & RPLLDIV2XO ) )
+++                                        VCLKIndex = YPbPr525iVCLK ;
+++                                }
+++                            }
+++                        }
+++                    }
+++                }
+++                else
+++                {
+++                    if ( pVBInfo->VBInfo & SetCRT2ToTV )
+++                    {
+++                        if ( pVBInfo->SetFlag & RPLLDIV2XO )
+++			{
+++                            VCLKIndex = TVVCLKDIV2 ;
+++
+++
+++                            VCLKIndex += 25 ;
+++
+++                        }
+++                        else
+++                        {
+++                            VCLKIndex = TVVCLK ;
+++
+++
+++                            VCLKIndex += 25 ;

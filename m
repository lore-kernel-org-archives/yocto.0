> RDEPENDS=5F${PN} =3D "initscripts"

> DEPENDS =3D "iproute2"

> SRC=5FURI =3D "file://can=5Fif"

> INITSCRIPT=5FPARAMS =3D "start 02 2 3 4 5 . stop 01 0 1 6 ."
> INITSCRIPT=5FNAME =3D "can=5Fif"

> CONFFILES=5F${PN} +=3D "${sysconfdir}/init.d/can=5Fif"

